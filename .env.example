# ============================================================
# Nature Video Generator — Environment Variable Overrides
# ============================================================
# Copy this file to .env and fill in your values.
# These override config/app.yaml settings.
# NEVER commit .env to version control.
# ============================================================

# LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen/qwen3.8-27b
# LM_STUDIO_MODEL=prism-ml/bonsai-27b

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Music provider
MUSIC_PROVIDER=stub
# MUSIC_PROVIDER=audiocraft

# FFmpeg (override if not in PATH)
# FFMPEG_BINARY=C:\path\to\ffmpeg.exe
# FFMPEG_FFPROBE_BINARY=C:\path\to\ffprobe.exe

# Output directory
# PATH_OUTPUT_DIR=output
