# ============================================================
# Nature Video Automation - .gitignore
# ============================================================

# Environment variables & secrets
.env
.env*.local

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Project outputs & temporary generated media
output/
*.mp4
*.m4v
*.avi
*.mov
*.wav
*.mp3
*.ogg
*.aac

# Backup folders / working copies
workflows - Copy/
* - Copy/

# Local model weights, checkpoints, & large asset files
*.ckpt
*.safetensors
*.bin
*.pt
*.pth
*.gguf

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE / Editor configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~
